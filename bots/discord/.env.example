DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-test-guild-id

# Optional: enables /ask (Ollama Cloud)
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Optional: enables /post (Instagram publishing). NOTE: /post is currently
# commented out of commands/index.ts, so setting these alone will not show it.
# Numeric IG Business account id, and a long-lived Graph API token.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
