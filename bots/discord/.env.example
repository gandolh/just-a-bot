DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-test-guild-id

# Optional: enables /ask (Ollama Cloud)
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Optional: the Jukebox (music from atrium in voice channels). All four or none:
# a partial set stops the bot at boot. The username and password are the bot's
# own Ward account (role `jukebox` on atrium); put the real ones only in
# bots/discord/.env, never in a committed file.
#   JUKEBOX_ATRIUM_URL=https://gandolh.ro/atrium-api
#   JUKEBOX_WARD_URL=https://gandolh.ro/ward-api
JUKEBOX_ATRIUM_URL=
JUKEBOX_WARD_URL=
JUKEBOX_WARD_USERNAME=
JUKEBOX_WARD_PASSWORD=
