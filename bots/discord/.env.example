DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id
GUILD_ID=your-test-guild-id

# Optional: enables /ask (Ollama Cloud)
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Optional: the Jukebox (music from atrium in voice channels). All three or none:
# a partial set stops the bot at boot. The username and password are the bot's
# own local atrium user (role `jukebox`), not a Ward account; put the real ones
# only in bots/discord/.env, never in a committed file.
#   JUKEBOX_ATRIUM_URL=https://example.com/atrium-api
# The old JUKEBOX_WARD_URL, JUKEBOX_WARD_USERNAME and JUKEBOX_WARD_PASSWORD are
# no longer read.
JUKEBOX_ATRIUM_URL=
JUKEBOX_ATRIUM_USERNAME=
JUKEBOX_ATRIUM_PASSWORD=
