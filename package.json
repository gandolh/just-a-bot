{
  "name": "just-a-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared",
    "bots/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "music:update-ytdlp": "node_modules/youtube-dl-exec/bin/yt-dlp -U",
    "discord:dev": "npm run dev -w @bots/discord",
    "discord:register": "npm run register -w @bots/discord",
    "discord:start": "npm run start -w @bots/discord",
    "whatsapp:dev": "npm run dev -w @bots/whatsapp",
    "whatsapp:start": "npm run start -w @bots/whatsapp",
    "slack:dev": "npm run dev -w @bots/slack",
    "slack:start": "npm run start -w @bots/slack",
    "dice-activity:dev:server": "npm run dev:server -w @bots/dice-activity",
    "dice-activity:dev:client": "npm run dev:client -w @bots/dice-activity",
    "dice-activity:build": "npm run build -w @bots/dice-activity",
    "dice-activity:start": "npm run start -w @bots/dice-activity"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsx": "4.22.3",
    "typescript": "5.7.3"
  }
}
