{
  "name": "just-a-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared",
    "bots/discord",
    "docs-site"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:conventions && npm run test:clean",
    "check:fast": "npm run typecheck && node scripts/check-fast.mjs",
    "check:conventions": "knip && depcruise shared/src bots/discord/src && node vendor/house-style/bin/check-base-ui.mjs && node vendor/house-style/bin/check-structure.mjs",
    "corpus:lint": "bash corpus/lint.sh",
    "codegraph:init": "codegraph init",
    "codegraph:sync": "codegraph sync",
    "discord:dev": "npm run dev -w @bots/discord",
    "discord:register": "npm run register -w @bots/discord",
    "discord:jukebox-check": "npm run jukebox:check -w @bots/discord",
    "discord:start": "npm run start -w @bots/discord",
    "test": "npm run test --workspaces --if-present",
    "test:clean": "node scripts/test-clean.mjs",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs"
  },
  "dependencies": {
    "tsx": "4.22.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.5",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "^2.1.2"
    },
    "serialize-javascript": "^7.0.5",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "postcss-selector-parser": "^7.1.6"
  }
}
