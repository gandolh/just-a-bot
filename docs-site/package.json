{
  "name": "@bots/docs-site",
  "version": "1.0.0",
  "private": true,
  "description": "just-a-bot documentation site — narrative rendered from corpus/ and docs/, diagrams compiled by archify, built with Docusaurus.",
  "scripts": {
    "sync-corpus": "node scripts/sync-corpus.mjs",
    "diagrams": "node scripts/build-diagrams.mjs",
    "ref": "typedoc",
    "prestart": "npm run sync-corpus && npm run diagrams",
    "start": "docusaurus start",
    "dev": "npm run start",
    "docs": "npm run sync-corpus && npm run diagrams && npm run ref && docusaurus build --out-dir dist",
    "typecheck": "tsc",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/react": "^19.2.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  },
  "engines": { "node": ">=20.0" }
}
